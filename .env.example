# Valores locais do desafio. Não são credencial de produção.
# O Compose já usa estes defaults. Copiar para .env é opcional.

POSTGRES_USER=junglegaming
# A senha entra interpolada dentro de um DSN, no `compose.yaml` e no `Makefile`,
# então `@`, `:`, `/`, `?` e `#` têm de vir percent-encoded aqui. Crua, ela quebra
# a string de conexão com um erro que não nomeia chave de configuração nenhuma.
POSTGRES_PASSWORD=junglegaming
POSTGRES_DB=junglegaming

# O banco que recebe o schema. O default é o da aplicação; a suíte de jornada
# tem um banco próprio no mesmo cluster, e o caminho publicado no README nomeia
# o destino no próprio comando do migrate em vez de depender desta variável.
MIGRATE_DB=junglegaming

# Quantas réplicas do processo o Compose sobe atrás do balanceador em
# `localhost:8090`. `make up REPLICAS=n` passa por cima numa subida.
WAGER_REPLICAS=3

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# As chaves que o processo exige para subir. Dentro do Compose o serviço `wager`
# já as define, e o Compose não passa este arquivo para dentro do container: elas
# estão aqui para quem sobe o binário no host, onde o processo morre com
# `config: <CHAVE> is missing` na primeira que faltar. Os endereços abaixo são os
# do host; dentro da rede do Compose cada um é o nome do serviço.
HTTP_ADDR=:8090
# Este é o banco da aplicação, e `DATABASE_URL` é a mesma chave que os sete
# pacotes de `internal/e2e` leem. Exportar este arquivo para o shell — direnv, ou
# `export $(grep -v "^#" .env | xargs)` — e rodar `go test -tags=integration` põe a
# suíte de jornada no banco da aplicação, cujo relay de outbox publica a linha que
# um caso espera ver morta. O default da suíte só vale com a variável ausente.
# `make test-journey` e `make cover-journey` a definem na própria receita.
DATABASE_URL=postgres://junglegaming:junglegaming@localhost:5432/junglegaming?sslmode=disable
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SNS_ENDPOINT=http://localhost:4566
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wallet-events.fifo
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
CLIENTS_PATH=deploy/local/clients.yaml
QUEUE_SENDERS_PATH=deploy/local/queue-senders.yaml

# O issuer é o que o token anuncia em `iss`, visto do host. O JWKS é buscado de
# dentro da rede do Compose, onde `localhost` seria o próprio processo. Fora do
# Compose, deixe IDP_JWKS_URL vazio e o processo deriva do issuer.
IDP_ISSUER=http://localhost:8080/realms/junglegaming
IDP_JWKS_URL=

# As demais chaves que `internal/platform/config` lê são opcionais e caem em
# default no código: OTEL_SAMPLE_RATIO, SHUTDOWN_TIMEOUT, PPROF_ADDR,
# REFERENCE_TTL, REFERENCE_INTERVAL, OUTBOX_INTERVAL, OUTBOX_LEASE, QUEUE_POLL,
# QUEUE_VISIBILITY e QUEUE_TIMEOUT.
